{
  "version": 2,
  "outputDirectory": ".",
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],
  "functions": {
    "app/main.py": {
      "maxDuration": 60
    }
  },
  "env": {
    "DATABASE_URL": "sqlite+aiosqlite:////tmp/ride_chatbot.db"
  }
}